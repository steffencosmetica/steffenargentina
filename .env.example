# Copiá este archivo como .env.local (desarrollo) o cargá las variables en Vercel / Dokploy.
# Nunca subas a Git un archivo con valores reales.

# --- Supabase (catálogo de la tienda) ---------------------------------------
# Supabase > Project Settings > API (o Data API).
# Son valores públicos: el acceso real lo controlan las políticas RLS de la base.
# Al ser NEXT_PUBLIC_ se incrustan en el build: en Docker se pasan como build args.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...). La clave "anon" legacy también funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Checkout (Fase 4B.5) -------------------------------------------------------
# Clave SECRETA de Supabase (sb_secret_...), solo de SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
# La usan únicamente crear_pedido() y consultar_pedido() (src/lib/supabase/admin.ts).
# Por ahora SOLO en desarrollo con Supabase local: `npx supabase status` → SECRET_KEY. No cargarla en Vercel.
# El checkout además exige el carrito habilitado (abajo) y compras habilitadas en la base local:
#   npm run checkout:local -- activar --confirmo=local:127.0.0.1:55322   (ver supabase/docs/checkout.md)
# SUPABASE_SECRET_KEY=

# --- Carrito (Fase 4B.4) -------------------------------------------------------
# Variable de SERVIDOR (sin NEXT_PUBLIC_). Con "1" el carrito se ve SOLO si además Supabase es local
# (127.0.0.1 / localhost) y no se está en Vercel: en Preview y Production queda oculto aunque se defina.
# No habilita compras: la base mantiene checkout_enabled = false. Ver supabase/docs/carrito.md.
# STEFFEN_CART_ENABLED=1

# --- Publicación de la Fase 4B.7 (APAGADO por defecto) -----------------------------
# Variables de SERVIDOR. Solo el valor exacto "1" las enciende. Apagadas, las rutas responden 404 y no hay enlaces.
# Las páginas estáticas las leen al compilar: cambiarlas exige un nuevo build (en Docker, también como build arg).
# Términos, Privacidad, Envíos y Cambios (borradores: NO encender hasta la aprobación jurídica y fiscal).
# STEFFEN_LEGAL_PAGES=
# Botón de Arrepentimiento, recuperación, sus API y /admin/arrepentimientos (encender al empezar a vender,
# con las migraciones 20261105120000 y 20261106120000 aplicadas y SUPABASE_SECRET_KEY configurada).
# STEFFEN_REVOCATION_ENABLED=

# --- Correo transaccional del arrepentimiento (Fase 4B.7) ------------------------
# Todas son variables de SERVIDOR (nunca NEXT_PUBLIC_). Guía completa: docs/zoho-correo.md.
# desactivado (predeterminado): no se envía nada; las comunicaciones quedan pendientes en la base.
# archivo: SOLO desarrollo/pruebas con Supabase local; escribe cada email como JSON en MAIL_CAPTURE_DIR.
# smtp: Zoho. Exige además MAIL_ALLOW_REAL_SEND=1 (protección contra envíos reales accidentales).
# MAIL_TRANSPORT=desactivado
# Remitente verificado: la dirección de la cuenta SMTP o uno de sus alias (Zoho rechaza otros remitentes).
# MAIL_FROM="Steffen Cosmética Capilar <info@steffenargentina.com.ar>"
# MAIL_REPLY_TO=info@steffenargentina.com.ar
# Base de los enlaces privados de recuperación (https en producción).
# MAIL_LINK_BASE_URL=https://steffenargentina.com.ar
# MAIL_CAPTURE_DIR=./.mail-capturas
# MAIL_ALLOW_REAL_SEND=
# Obligatoria con smtp: host del proyecto de Supabase al que pertenece esta cola (p. ej. <ref>.supabase.co).
# Si no coincide con NEXT_PUBLIC_SUPABASE_URL, no se envía nada. SMTP nunca funciona con Supabase local.
# MAIL_SUPABASE_HOST=
# Zoho Mail (cuenta de organización paga): smtppro.zoho.com:465 (SSL) o smtp.zoho.com:587 (STARTTLS).
# Zoho ZeptoMail / CPaaS: smtp.zeptomail.com:465 o 587, usuario "emailapikey".
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=
# Contraseña de aplicación (Zoho Mail) o token de envío (ZeptoMail). NUNCA la contraseña personal de la cuenta.
# MAIL_SMTP_PASSWORD=
# Ejecutor autónomo (scripts/mail-worker.ts).
# MAIL_WORKER_ID=
# MAIL_WORKER_INTERVAL_SECONDS=30
# MAIL_WORKER_MAX_SILENCE_MINUTES=10
# Token del monitor externo GET /api/interno/comunicaciones (mínimo 32 caracteres aleatorios). Sin él la ruta no existe.
# MAIL_HEALTH_TOKEN=

# --- IP del cliente detrás de Traefik (VPS con Dokploy, Fase 4B.8) ----------------------
# Ver docs/proxy-traefik.md. Sin estas variables, fuera de local y de Vercel las operaciones sensibles se rechazan.
# STEFFEN_TRUSTED_PROXY=traefik
# Secreto que agrega el middleware de Traefik en X-Steffen-Proxy-Auth (≥ 32 caracteres; solo en el servidor).
# STEFFEN_PROXY_SECRET=
# Solo si hay un proxy delante de Traefik (p. ej. rangos de Cloudflare), separados por coma.
# STEFFEN_TRUSTED_UPSTREAM_CIDRS=
# Temporal, solo para la aceptación en el VPS (GET /api/interno/proxy). Quitar después de verificar.
# STEFFEN_PROXY_DIAGNOSTIC_TOKEN=
# NUNCA en producción: solo el arnés local de pruebas con clientes en una red Docker privada.
# STEFFEN_PROXY_ALLOW_PRIVATE_CLIENTS=

# Fase 5B: solo next dev y Supabase local, con los controles de checkout vigentes.
# STEFFEN_MP_MODE=mock
# STEFFEN_MP_LOCAL_ORIGIN=http://localhost:3000
# Fase 5C: además del modo mock, habilita receptor y conciliador solo en desarrollo local.
# STEFFEN_MP_RECONCILIATION=0
# STEFFEN_MP_MOCK_WEBHOOK_SECRET=
# Fase 5D: posventa simulada dentro del panel, además de los flags de Fase 5C.
# STEFFEN_MP_AFTER_SALES=0
